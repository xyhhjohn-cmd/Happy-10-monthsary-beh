/* =================================
   MUSIC
================================= */

const music=
document.getElementById("music");

const musicBtn=
document.getElementById("musicBtn");

function startMusic(){

  music.volume=.4;

  music.play()
  .then(()=>{

    musicBtn.textContent="🎵";

  })
  .catch(()=>{

    musicBtn.textContent="🔇";

  });

}


function toggleMusic(){

  if(music.paused){

    music.play();

    musicBtn.textContent="🎵";

  }else{

    music.pause();

    musicBtn.textContent="🔇";

  }

}


