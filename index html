/* =================================
   ARROW GAME
================================= */

const arrow=
document.getElementById("arrow");

const target=
document.getElementById("target");

const envelope=
document.getElementById("envelope");

let dragging=false;
let gameFinished=false;

function pointer(e){

  return {
    x:e.clientX,
    y:e.clientY
  };

}


arrow.addEventListener(
  "pointerdown",
  e=>{

    if(gameFinished)return;

    dragging=true;

    arrow.classList.add("dragging");

    arrow.setPointerCapture(
      e.pointerId
    );

  }
);


window.addEventListener(
  "pointermove",
  e=>{

    if(!dragging)return;

    const p=pointer(e);

    const rect=
    document
    .querySelector(".bowArea")
    .getBoundingClientRect();

    let x=
    p.x-rect.left;

    let y=
    p.y-rect.top;

    x=Math.max(
      25,
      Math.min(150,x)
    );

    y=Math.max(
      35,
      Math.min(155,y)
    );

    arrow.style.left=x+"px";
    arrow.style.top=y+"px";

    const bow=
    document
    .querySelector(".bowArea")
    .getBoundingClientRect();

    const cx=
    bow.left+55;

    const cy=
    bow.top+85;

    const angle=
    Math.atan2(
      p.y-cy,
      p.x-cx
    )*180/Math.PI;

    arrow.style.transform=
    `rotate(${angle}deg)`;

  }
);


window.addEventListener(
  "pointerup",
  e=>{

    if(!dragging)return;

    dragging=false;

    arrow.classList.remove(
      "dragging"
    );

    const p=pointer(e);

    const t=
    target.getBoundingClientRect();

    const tx=
    t.left+t.width/2;

    const ty=
    t.top+t.height/2;

    const distance=
    Math.hypot(
      p.x-tx,
      p.y-ty
    );

    if(distance<125){

      hitTarget();

    }else{

      arrow.style.left="24px";
      arrow.style.top="85px";

      arrow.style.transform=
      "rotate(0deg)";

    }

  }
);


/* =================================
   HIT TARGET
================================= */

function hitTarget(){

  if(gameFinished)return;

  gameFinished=true;

  target.classList.add("hit");

  arrow.style.transition=".3s";

  arrow.style.left="70%";

  createBurst();

  /* Music starts immediately after hit */

  startMusic();

  setTimeout(()=>{

    target.style.opacity="0";

    envelope.classList.add("show");

  },450);

  setTimeout(()=>{

    envelope.classList.add("open");

  },1100);

  setTimeout(()=>{

    startCinematic();

  },1900);

}


