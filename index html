<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no"><title>10 Months With You 💜</title><style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --purple:#7b2cbf;
  --violet:#9d4edd;
  --light:#d8a4ff;
  --soft:#f0d9ff;
  --dark:#08000f;
}

html,body{
  width:100%;
  height:100%;
  overflow:hidden;
  font-family:Arial,sans-serif;
  background:var(--dark);
  color:white;
}

button{
  font-family:inherit;
}

/* ==============================
   BACKGROUND
============================== */

.screen{
  position:absolute;
  inset:0;
  display:none;
  justify-content:center;
  align-items:center;
  overflow:hidden;
  text-align:center;

  background:
    radial-gradient(circle at 50% 15%,#9d4edd55,transparent 30%),
    radial-gradient(circle at 20% 80%,#7b2cbf33,transparent 30%),
    linear-gradient(145deg,#07000d,#190023,#0b0012);
}

.screen.active{
  display:flex;
}

.content{
  position:relative;
  z-index:10;
  width:min(92%,520px);
}

h1{
  font-size:clamp(42px,12vw,75px);
  color:#f3dcff;
  text-shadow:
    0 0 10px #d8a4ff,
    0 0 30px #9d4edd,
    0 0 70px #7b2cbf;
}

h2{
  font-size:clamp(25px,7vw,38px);
  color:#ecd2ff;
  margin-bottom:18px;
  text-shadow:0 0 20px #9d4edd;
}

p{
  font-size:16px;
  line-height:1.8;
  color:#f5eaff;
}

.small{
  font-size:13px;
  opacity:.75;
}

.primaryBtn{
  margin-top:25px;
  padding:14px 27px;
  border:1px solid #d8a4ff88;
  border-radius:40px;
  color:white;
  background:linear-gradient(90deg,#6a1b9a,#c77dff);
  box-shadow:
    0 0 15px #9d4edd88,
    inset 0 0 15px #ffffff12;
  font-size:15px;
  transition:.3s;
  cursor:pointer;
}

.primaryBtn:active{
  transform:scale(.94);
}

/* ==============================
   SCROLLABLE PAGE
============================== */

.scrollScreen{
  align-items:flex-start;
  overflow-y:auto;
  overflow-x:hidden;
  -webkit-overflow-scrolling:touch;
}

.scrollScreen .content{
  margin-top:45px;
  margin-bottom:60px;
}

.scrollScreen::-webkit-scrollbar{
  width:5px;
}

.scrollScreen::-webkit-scrollbar-thumb{
  background:#c77dff88;
  border-radius:10px;
}

/* ==============================
   STARS
============================== */

#stars{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:1;
}

.star{
  position:absolute;
  width:2px;
  height:2px;
  border-radius:50%;
  background:#fff;
  animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
  from{
    opacity:.15;
    transform:scale(.7);
  }
  to{
    opacity:1;
    transform:scale(1.5);
  }
}

/* ==============================
   FLOATING PARTICLES
============================== */

.particle{
  position:fixed;
  pointer-events:none;
  z-index:500;
  animation:floatParticle linear forwards;
}

@keyframes floatParticle{
  from{
    transform:translateY(0) scale(.7) rotate(0deg);
    opacity:0;
  }

  15%{
    opacity:1;
  }

  to{
    transform:translateY(-110vh) scale(1.3) rotate(360deg);
    opacity:0;
  }
}

/* ==============================
   MUSIC
============================== */

.musicBtn{
  position:fixed;
  top:15px;
  right:15px;
  z-index:100;

  width:45px;
  height:45px;
  border-radius:50%;
  border:1px solid #d8a4ff99;

  color:white;
  background:#4a167288;
  backdrop-filter:blur(10px);

  font-size:18px;
  cursor:pointer;
}

/* ==============================
   ARROW GAME
============================== */

#gameScreen{
  background:
    radial-gradient(circle at 50% 45%,#9d4edd33,transparent 38%),
    linear-gradient(160deg,#06000c,#1c0028,#09000e);
}

.gameTitle{
  position:absolute;
  top:35px;
  left:0;
  right:0;
  z-index:10;
}

.gameTitle h2{
  margin:0;
  font-size:27px;
}

.instruction{
  position:absolute;
  top:85px;
  left:20px;
  right:20px;
  color:#e0c6ed;
  font-size:13px;
  line-height:1.7;
}

/* target */

.target{
  position:absolute;
  right:10%;
  top:44%;

  width:88px;
  height:88px;

  border-radius:50%;

  background:
    radial-gradient(circle,
      #fff 0 8%,
      #e9baff 9% 20%,
      #9d4edd 21% 38%,
      #4a1672 39% 60%,
      #1d002b 61%);

  border:2px solid #e5c5ff;

  box-shadow:
    0 0 15px #c77dff,
    0 0 40px #9d4edd,
    0 0 80px #7b2cbf88;

  transition:.4s;
}

.target::after{
  content:"";
  position:absolute;
  inset:-12px;
  border:1px solid #c77dff55;
  border-radius:50%;
  animation:targetPulse 2s infinite;
}

@keyframes targetPulse{
  50%{
    transform:scale(1.15);
    opacity:.2;
  }
}

.target.hit{
  animation:hit .7s;
}

@keyframes hit{
  50%{
    transform:scale(1.5);
    filter:brightness(2.5);
  }
}

/* envelope */

.envelope{
  position:absolute;
  right:10%;
  top:44%;

  width:92px;
  height:65px;

  border-radius:9px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:linear-gradient(145deg,#fff,#e9d3ff);
  color:#7b2cbf;

  font-size:35px;

  opacity:0;
  transform:scale(.2) rotate(-20deg);

  box-shadow:
    0 0 25px #e0aaff,
    0 0 60px #9d4edd;

  transition:.8s cubic-bezier(.2,1.4,.5,1);
}

.envelope.show{
  opacity:1;
  transform:scale(1) rotate(0);
}

.envelope.open{
  transform:scale(1.2) rotate(5deg);
  box-shadow:
    0 0 40px #fff,
    0 0 90px #c77dff;
}

/* bow */

.bowArea{
  position:absolute;
  left:12px;
  bottom:110px;

  width:185px;
  height:190px;

  touch-action:none;
}

.bow{
  position:absolute;
  left:28px;
  top:15px;

  width:105px;
  height:160px;

  border:7px solid #d8a4ff;
  border-left:0;
  border-radius:0 90px 90px 0;

  filter:
    drop-shadow(0 0 8px #c77dff)
    drop-shadow(0 0 20px #7b2cbf);
}

.string{
  position:absolute;
  left:25px;
  top:8px;

  width:3px;
  height:170px;

  background:#f3e8ff;

  box-shadow:0 0 8px #fff;
}

/* ==============================
   CUPID ARROW
============================== */

.arrow{
  position:absolute;
  left:24px;
  top:85px;

  width:155px;
  height:5px;

  background:linear-gradient(90deg,#fff,#d8a4ff);

  transform-origin:left center;

  filter:
    drop-shadow(0 0 6px #fff)
    drop-shadow(0 0 15px #c77dff);

  touch-action:none;
  cursor:grab;
}

/* heart at the tail/base */
.arrow::before{
  content:"";
  position:absolute;
  left:-3px;
  top:-7px;

  width:14px;
  height:14px;

  background:#c77dff;

  transform:rotate(-45deg);
  border-radius:2px;

  box-shadow:
    0 0 8px #c77dff,
    0 0 15px #9d4edd;
}

.arrow::before::before,
.arrow::before::after{
  content:"";
  position:absolute;
  width:14px;
  height:14px;
  border-radius:50%;
  background:#c77dff;
}

.arrow::before::before{
  top:-7px;
  left:0;
}

.arrow::before::after{
  top:0;
  left:7px;
}

/* ❤️ ONLY HEART AS THE ARROW TIP */
.arrow::after{
  content:"♥";
  position:absolute;

  right:-17px;
  top:-15px;

  font-size:27px;
  line-height:1;

  color:#ffb7ef;

  text-shadow:
    0 0 5px #fff,
    0 0 12px #ff8de1,
    0 0 25px #c77dff;

  transform:rotate(0deg);
}

.arrow.dragging{
  cursor:grabbing;
}

/* ==============================
   CINEMATIC INTRO
============================== */

.cinematic{
  position:fixed;
  inset:0;
  background:#050008;
  z-index:200;

  display:flex;
  justify-content:center;
  align-items:center;

  opacity:0;
  pointer-events:none;

  transition:1s;
}

.cinematic.show{
  opacity:1;
}

.cinematicText{
  width:90%;
  text-align:center;
  font-size:24px;
  line-height:1.8;
  color:#eee0ff;
  text-shadow:0 0 20px #9d4edd;
}

.cinematicText .big{
  font-size:clamp(38px,11vw,70px);
  font-weight:bold;
  color:#f0d9ff;
}

/* ==============================
   LETTER
============================== */

.letter{
  width:min(92%,440px);

  min-height:300px;

  padding:32px 24px;

  background:
    linear-gradient(145deg,#fff,#ead7f5);

  color:#39104d;

  border-radius:8px;

  box-shadow:
    0 0 30px #d8a4ff,
    0 0 80px #7b2cbf88;

  transform:rotate(-1deg);

  margin:0 auto;
}

.letter h2{
  color:#6a1b9a;
  text-shadow:none;
  margin-bottom:20px;
}

.letter p{
  color:#4d285a;
  line-height:1.7;
}

/* Important:
   Makes the typed letter readable
   and allows the whole message to grow.
*/

.letter .typing{
  min-height:0;
  max-height:none;
  overflow:visible;
}

/* ==============================
   TYPING
============================== */

.typing{
  min-height:150px;
  text-align:left;
  font-size:16px;
  line-height:1.9;
  color:#f5eaff;
  overflow-wrap:break-word;
}

/* ==============================
   SINGLE PHOTO
============================== */

.photo{
  width:210px;
  height:210px;

  object-fit:cover;

  border-radius:22px;

  border:3px solid #d8a4ff;

  box-shadow:
    0 0 20px #c77dff,
    0 0 60px #7b2cbf88;

  margin:20px auto;

  display:block;
}

.photoTitle{
  color:#e5c7f5;
  margin-bottom:5px;
}

/* ==============================
   REASONS
============================== */

.reasonGrid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  margin-top:15px;
}

.reason{
  min-height:65px;

  display:flex;
  justify-content:center;
  align-items:center;

  padding:10px;

  border-radius:15px;

  background:#ffffff0d;
  border:1px solid #c77dff44;

  color:#f2ddff;

  transition:.3s;
}

.reason:active{
  transform:scale(.95);
}

.reason.revealed{
  background:#7b2cbf55;
  box-shadow:0 0 20px #9d4edd55;
}

/* ==============================
   FINAL
============================== */

.finalTitle{
  font-size:clamp(40px,12vw,65px);
  font-weight:bold;

  color:#f2d7ff;

  text-shadow:
    0 0 10px #fff,
    0 0 30px #c77dff,
    0 0 70px #7b2cbf;
}

.finalHeart{
  font-size:80px;
  animation:heartBeat 1.4s infinite;
}

@keyframes heartBeat{
  50%{
    transform:scale(1.18);
  }
}

/* ==============================
   LOVE QUESTION
============================== */

.loveQuestion{
  position:relative;
  min-height:350px;
}

.loveTitle{
  font-size:clamp(32px,9vw,55px);
  color:#f3dcff;
  text-shadow:
    0 0 10px #fff,
    0 0 30px #c77dff,
    0 0 60px #7b2cbf;
}

.loveButtons{
  position:relative;
  width:100%;
  height:140px;
  margin-top:20px;
}

.loveBtn{
  position:absolute;

  padding:13px 30px;

  border-radius:40px;
  border:1px solid #d8a4ff88;

  color:white;

  font-size:16px;

  cursor:pointer;

  transition:.25s;

  box-shadow:0 0 18px #9d4edd66;
}

.yesBtn{
  left:20%;
  background:linear-gradient(
    90deg,
    #6a1b9a,
    #c77dff
  );
}

.noBtn{
  right:20%;
  background:#24102f;
}

/* ==============================
   CONTINUE MEMORIES
============================== */

.continueBtn{
  animation:continueGlow 1.7s infinite;
}

@keyframes continueGlow{
  0%,100%{
    box-shadow:0 0 15px #9d4edd66;
  }

  50%{
    box-shadow:
      0 0 25px #c77dff,
      0 0 50px #9d4edd88;
  }
}

/* ==============================
   CELEBRATION
============================== */

.celebrateEmoji{
  position:fixed;
  pointer-events:none;
  z-index:999;

  font-size:25px;

  animation:
    celebrateFly 2.5s
    cubic-bezier(.15,.7,.2,1)
    forwards;
}

@keyframes celebrateFly{

  0%{
    transform:
      translate(0,0)
      scale(.3)
      rotate(0deg);

    opacity:0;
  }

  15%{
    opacity:1;
  }

  100%{
    transform:
      translate(
        var(--x),
        var(--y)
      )
      scale(1.5)
      rotate(var(--r));

    opacity:0;
  }

}

/* ==============================
   RESPONSIVE
============================== */

@media(max-width:430px){

  .bowArea{
    transform:scale(.86);
    transform-origin:bottom left;
    left:0;
  }

  .target,
  .envelope{
    right:7%;
  }

  .target{
    width:78px;
    height:78px;
  }

  .envelope{
    width:82px;
    height:58px;
  }

  p{
    font-size:14px;
  }

  .photo{
    width:175px;
    height:175px;
  }

  .reason{
    font-size:13px;
  }

  .yesBtn{
    left:12%;
  }

  .noBtn{
    right:12%;
  }

  /* Better mobile letter spacing */
  .scrollScreen .content{
    width:94%;
    margin-top:65px;
    margin-bottom:70px;
  }

  .scrollScreen .letter{
    width:100%;
    padding:28px 20px;
  }

  .scrollScreen .typing{
    font-size:14px;
    line-height:1.8;
  }

  .scrollScreen .primaryBtn{
    margin-bottom:20px;
  }

}

@media(max-width:360px){

  .yesBtn{
    left:5%;
  }

  .noBtn{
    right:5%;
  }

  .scrollScreen .letter{
    padding:25px 17px;
  }

  .scrollScreen .typing{
    font-size:13px;
    line-height:1.75;
  }

}

