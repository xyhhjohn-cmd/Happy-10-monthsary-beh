let storyStarted=false;

const storyMessage=
`It started with two people...

Two people who talked,
laughed, shared stories,
and slowly became important
to each other.

And somehow,
those little moments became
ten beautiful months together.

I'm grateful for every chapter
we've already written. 💜`;

function typeText(element,text,speed=30){

  element.innerHTML="";

  let i=0;

  function type(){

    if(i<text.length){

      element.innerHTML=
      text.substring(0,i+1)
      .replace(/\n/g,"<br>");

      i++;

      setTimeout(type,speed);

    }

  }

  type();

}


function startStoryTyping(){

  if(storyStarted)return;

  storyStarted=true;

  typeText(
    document.getElementById(
      "typingText"
    ),
    storyMessage,
    25
  );

}


